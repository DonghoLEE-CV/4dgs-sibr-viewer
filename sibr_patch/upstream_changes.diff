+
+bool sibr::GaussianView::loadSequence(const std::string& path)
+{
+	std::ifstream f(path, std::ios_base::binary);
+	char magic[4]; int N = 0, F = 0, shc = 0; float tlast = 1.f; char pad[12];
+	f.read(magic, 4); f.read((char*)&N, 4); f.read((char*)&F, 4); f.read((char*)&shc, 4); f.read((char*)&tlast, 4); f.read(pad, 12);
+	if (std::string(magic, 4) != "G4D1" || shc != 16 || F <= 0)
+	{
+		SIBR_WRG << "sequence.g4d: bad header, staying static" << std::endl;
+		return false;
+	}
+	if (N != count)
+	{
+		SIBR_WRG << "sequence.g4d: N=" << N << " but ply has " << count << ", staying static" << std::endl;
+		return false;
+	}
+	_seqFrameBytes = g4dFrameBytes(N);
+	size_t total = _seqFrameBytes * (size_t)F;
+	if (cudaMalloc((void**)&_seqCuda, total) != cudaSuccess)
+	{
+		SIBR_WRG << "sequence.g4d: not enough GPU memory for " << total / 1e9 << " GB, staying static" << std::endl;
+		cudaGetLastError();
+		_seqCuda = nullptr;
+		return false;
+	}
+	SIBR_LOG << "Loading 4D sequence " << path << ": " << F << " frames, " << total / 1e9 << " GB to GPU" << std::endl;
+	std::vector<char> buf(_seqFrameBytes);
+	for (int k = 0; k < F; k++)
+	{
+		f.read(buf.data(), _seqFrameBytes);
+		if (!f) { SIBR_WRG << "sequence.g4d truncated at frame " << k << std::endl; F = k; break; }
+		CUDA_SAFE_CALL_ALWAYS(cudaMemcpy(_seqCuda + _seqFrameBytes * k, buf.data(), _seqFrameBytes, cudaMemcpyHostToDevice));
+	}
+	_seqFrames = F;
+	_seqTLast = tlast;
+	_seqPath = path;
+	_seqLoaded = F > 0;
+	_seqShown = -1;
+	if (_seqLoaded) showFrame(0);
+	return _seqLoaded;
+}
+
+void sibr::GaussianView::showFrame(int fr)
+{
+	if (!_seqLoaded) return;
+	fr = std::max(0, std::min(_seqFrames - 1, fr));
+	_seqFrame = fr;
+	if (fr == _seqShown) return;
+	g4dUnpackFrame(_seqCuda + _seqFrameBytes * fr, count, pos_cuda, rot_cuda, scale_cuda, opacity_cuda, shs_cuda);
+	_seqShown = fr;
 }
 
